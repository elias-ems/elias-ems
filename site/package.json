{
  "name": "elias-ems-docs",
  "private": true,
  "description": "The public documentation site for Elias ems, published to GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs:dev": "node scripts/sync-docs.mjs && vitepress dev",
    "docs:build": "node scripts/sync-docs.mjs && vitepress build",
    "docs:preview": "vitepress preview",
    "sync": "node scripts/sync-docs.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "lint": "npm --prefix ../addon exec --no -- biome check --config-path ../addon .",
    "lint:fix": "npm --prefix ../addon exec --no -- biome check --write --config-path ../addon .",
    "typecheck": "npm --prefix ../addon exec --no -- tsc -p ."
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
