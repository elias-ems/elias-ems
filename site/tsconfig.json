{
  // Check VitePress configuration and the browser planner boundary.
  "include": [".vitepress/config.ts", "lib/**/*.ts"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": [],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
