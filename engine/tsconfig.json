{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022", "DOM"],
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts"]
}
