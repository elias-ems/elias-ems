{
  // test/*.js are harness modules run straight by node, so they stay JavaScript
  // like server.js. They're included (not checked) purely so TypeScript can
  // infer their exports for the .ts tests that import them.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "test/**/*.js",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "allowJs": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  }
}
