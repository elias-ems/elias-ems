{
  "name": "elias-ems",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "react-router dev",
    "dev:mock": "node test/dev.js",
    "build": "react-router build",
    "start": "node server.js",
    "start:ingress": "npm run build && node test/stack.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "typecheck": "react-router typegen && tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@react-router/express": "^8.3.0",
    "@react-router/node": "^8.3.0",
    "express": "^5.2.1",
    "isbot": "^5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@playwright/test": "^1.62.1",
    "@react-router/dev": "^8.3.0",
    "@react-router/fs-routes": "^8.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "lefthook@2.1.10": true
  }
}
